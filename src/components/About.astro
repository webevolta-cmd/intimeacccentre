---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import { about } from '../data/site';
const { founders, certificate, office } = about.photos;
---

<section class="section section--tint about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__media">
      <figure class="about__photo about__photo--main" data-reveal>
        <div class="about__frame" data-parallax-frame>
          <Picture
            class="about__img"
            src={founders.src}
            alt={founders.alt}
            widths={[480, 720]}
            fallback={720}
            width={founders.width}
            height={founders.height}
            sizes="(max-width: 900px) 92vw, 40vw"
          />
        </div>
        <figcaption>{founders.caption}</figcaption>
      </figure>
      <figure class="about__photo about__photo--office" data-reveal>
        <div class="about__frame" data-parallax-frame>
          <Picture
            class="about__img"
            src={office.src}
            alt={office.alt}
            widths={[480, 720]}
            fallback={720}
            width={office.width}
            height={office.height}
            sizes="(max-width: 900px) 46vw, 18vw"
          />
        </div>
        <figcaption>{office.caption}</figcaption>
      </figure>
    </div>

    <div class="about__copy">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="about-title" class="about__title" data-split>{about.title}</h2>
      {about.paragraphs.map((p) => <p class="about__p" data-reveal>{p}</p>)}

      <blockquote class="about__quote" data-reveal>
        <p>«{about.quote}»</p>
        <footer>{about.quoteSource}</footer>
      </blockquote>

      <div class="credential" data-reveal>
        <div class="credential__media">
          <Picture
            class="credential__img"
            src={certificate.src}
            alt={certificate.alt}
            widths={[480, 720, 1080]}
            fallback={720}
            width={certificate.width}
            height={certificate.height}
            sizes="(max-width: 600px) 40vw, 200px"
          />
        </div>
        <div class="credential__body">
          <p class="credential__kicker">
            <Icon name="certificate" />
            {about.credential.title}
          </p>
          <p>{about.credential.text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 104px);
    align-items: start;
  }

  .about__media {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    margin-bottom: 18%;
  }

  .about__photo {
    display: grid;
    gap: 10px;
  }

  .about__photo figcaption {
    font-size: var(--t-label);
    font-weight: 600;
    font-stretch: 75%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about__photo--main {
    grid-column: 1 / 6;
    grid-row: 1;
  }

  .about__photo--office {
    grid-column: 4 / 7;
    grid-row: 1;
    align-self: end;
    margin-bottom: -22%;
    z-index: 1;
  }

  .about__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-leaf-lg);
    background: var(--paper);
    box-shadow: var(--shadow-lift);
  }

  .about__photo--main .about__frame {
    aspect-ratio: 9 / 10;
  }

  .about__photo--office .about__frame {
    aspect-ratio: 4 / 5;
    border: 6px solid var(--paper-2);
    border-radius: 4px 28px 4px 28px;
  }

  .about__img,
  .about__img img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about__img img {
    object-fit: cover;
    transform: scale(1.12);
    will-change: transform;
  }

  .about__copy {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  .about__title {
    font-size: var(--t-h2);
  }

  .about__p {
    color: var(--ink-2);
    font-size: 1.08rem;
    max-width: 60ch;
  }

  .about__quote {
    margin-top: 8px;
    padding: 4px 0 4px clamp(18px, 2.4vw, 28px);
    border-left: 3px solid var(--green);
  }

  .about__quote p {
    font-family: var(--f-display);
    font-stretch: 87.5%;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .about__quote footer {
    margin-top: 10px;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .credential {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    margin-top: 12px;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-leaf);
  }

  .credential__media {
    overflow: hidden;
    border-radius: 3px 16px 3px 16px;
    aspect-ratio: 4 / 5;
  }

  .credential__img,
  .credential__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .credential__body {
    display: grid;
    gap: 8px;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .credential__kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .credential__kicker .icon {
    color: var(--green);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__media {
      margin-bottom: 22%;
    }
  }

  @media (max-width: 520px) {
    .credential {
      grid-template-columns: 96px minmax(0, 1fr);
    }
  }
</style>
