---
import Icon from './Icon.astro';
import { faq } from '../data/site';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 id="faq-title" class="faq__title" data-split>{faq.title}</h2>
      <p class="faq__note" data-reveal>Չգտա՞ք ձեր հարցը։ <a class="link-arrow" href="#contact">Գրեք մեզ</a></p>
    </div>
    <div class="faq__list" data-faq>
      {
        faq.items.map((item, i) => (
          <details class="faq__item" name="faq" data-reveal open={i === 0}>
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 104px);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: grid;
    gap: 18px;
  }

  .faq__title {
    font-size: var(--t-h2);
  }

  .faq__note {
    color: var(--ink-2);
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__q {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px;
    align-items: center;
    gap: 20px;
    padding-block: 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--f-display);
    font-stretch: 87.5%;
    font-size: clamp(1.15rem, 1.02rem + 0.5vw, 1.4rem);
    line-height: 1.3;
    border-radius: 4px;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q::marker {
    content: '';
  }

  .faq__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(135deg);
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }

  .faq__q:hover .faq__icon {
    border-color: var(--ink);
  }

  .faq__a {
    overflow: hidden;
  }

  .faq__a p {
    padding-bottom: 26px;
    padding-right: 60px;
    color: var(--ink-2);
    max-width: 66ch;
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq__head {
      position: static;
    }

    .faq__a p {
      padding-right: 0;
    }
  }
</style>
