    '<path d="M5 3.5h14v11H5z"/><path d="M8.5 7.5h7"/><path d="M8.5 10.5h4"/><circle cx="15.5" cy="15.5" r="2.8"/><path d="m14 18-.8 3 2.3-1.2 2.3 1.2-.8-3"/>',
  team: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5a6 6 0 0 1 12 0"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.8 14.2a4.6 4.6 0 0 1 5.2 4.6"/>',
