---
import { process } from '../data/site';

/** Leaf-cornered rectangle (square TL/BR, rounded TR/BL), as in the logo. */
const leaf = (x: number, y: number, w: number, h: number, r = 18, s = 3) =>
  `M${x + s} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}V${y + h - s}Q${x + w} ${y + h} ${x + w - s} ${y + h}H${x + r}Q${x} ${y + h} ${x} ${y + h - r}V${y + s}Q${x} ${y} ${x + s} ${y}Z`;
---

<section class="section section--night process" id="process" aria-labelledby="process-title" data-process>
  <div class="process__glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2 id="process-title" data-split>{process.title}</h2>
      <p data-reveal>{process.intro}</p>
    </div>

    <div class="process__grid">
      <div class="process__stage" aria-hidden="true">
        <div class="process__stage-inner">
          <div class="process__counter">
            <span data-process-current>01</span><span class="process__counter-sep">/</span><span>05</span>
          </div>
          <svg class="process__art" viewBox="0 0 440 400" data-process-art>
            <defs>
              <pattern id="pa-grid" width="22" height="22" patternUnits="userSpaceOnUse">
                <path d="M22 0H0V22" fill="none" stroke="rgba(233,241,236,.07)" stroke-width="1"></path>
              </pattern>
            </defs>
            <rect width="440" height="400" fill="url(#pa-grid)"></rect>

            <!-- 1. First contact -->
            <g class="pa-scene is-active" data-scene="0">
              <path class="pa-card" d={leaf(70, 70, 150, 250, 26, 4)}></path>
              <rect class="pa-soft" x="88" y="96" width="114" height="160" rx="6"></rect>
              <circle class="pa-green" cx="145" cy="290" r="11"></circle>
              <g class="pa-bubbles">
                <path class="pa-bubble" d={leaf(240, 96, 140, 46, 16, 3)}></path>
                <rect class="pa-ink" x="258" y="113" width="80" height="6" rx="3"></rect>
                <rect class="pa-ink pa-ink--soft" x="258" y="125" width="52" height="5" rx="2.5"></rect>
                <path class="pa-bubble pa-bubble--green" d={leaf(258, 160, 128, 46, 16, 3)}></path>
                <rect class="pa-white" x="276" y="177" width="72" height="6" rx="3"></rect>
                <rect class="pa-white pa-white--soft" x="276" y="189" width="46" height="5" rx="2.5"></rect>
                <path class="pa-bubble" d={leaf(240, 224, 112, 40, 14, 3)}></path>
                <circle class="pa-dot" cx="266" cy="244" r="4"></circle>
                <circle class="pa-dot" cx="282" cy="244" r="4"></circle>
                <circle class="pa-dot" cx="298" cy="244" r="4"></circle>
              </g>
            </g>

            <!-- 2. Understanding needs -->
            <g class="pa-scene" data-scene="1">
              <path class="pa-card" d={leaf(80, 64, 220, 270, 30, 4)}></path>
              <rect class="pa-ink" x="104" y="96" width="120" height="8" rx="4"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="122" width="168" height="5" rx="2.5"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="136" width="150" height="5" rx="2.5"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="150" width="160" height="5" rx="2.5"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="186" width="140" height="5" rx="2.5"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="200" width="168" height="5" rx="2.5"></rect>
              <rect class="pa-ink pa-ink--soft" x="104" y="214" width="96" height="5" rx="2.5"></rect>
              <rect class="pa-highlight" x="100" y="180" width="178" height="42" rx="4"></rect>
              <circle class="pa-lens" cx="300" cy="236" r="62"></circle>
              <path class="pa-lens-handle" d="M344 280l46 46"></path>
            </g>

            <!-- 3. Scope & offer -->
            <g class="pa-scene" data-scene="2">
              <path class="pa-card" d={leaf(110, 48, 220, 300, 30, 4)}></path>
              <rect class="pa-ink" x="134" y="78" width="110" height="8" rx="4"></rect>
              {
                [0, 1, 2, 3].map((r) => (
                  <g>
                    <path class="pa-box" d={leaf(134, 112 + r * 36, 18, 18, 7, 2)} />
                    <path class="pa-tick" d={`M138 ${121 + r * 36}l3.6 3.6 6.4-6.8`} />
                    <rect class="pa-ink pa-ink--soft" x="164" y={118 + r * 36} width={[128, 104, 140, 92][r]} height="6" rx="3" />
                  </g>
                ))
              }
              <path class="pa-sign" d="M138 300c14-18 24-20 30-8s14 10 22-4 18-10 26 2 22 6 30-6"></path>
              <path class="pa-rule" d="M134 316H306"></path>
              <g class="pa-stamp">
                <circle cx="300" cy="96" r="30" class="pa-stamp-ring"></circle>
                <path class="pa-stamp-leaf" d={leaf(286, 82, 14, 14, 7, 1.5)}></path>
                <path class="pa-stamp-leaf pa-stamp-leaf--dark" d={leaf(294, 96, 14, 14, 7, 1.5)}></path>
              </g>
            </g>

            <!-- 4. Organising information -->
            <g class="pa-scene" data-scene="3">
              <path class="pa-folder-back" d="M70 130h96l18 20h186v190H70z"></path>
              <path class="pa-card pa-sheet" d={leaf(108, 92, 150, 170, 22, 3)}></path>
              <path class="pa-card pa-sheet" d={leaf(150, 76, 150, 170, 22, 3)}></path>
              <path class="pa-card pa-sheet" d={leaf(192, 100, 150, 170, 22, 3)}></path>
              <rect class="pa-ink pa-ink--soft" x="210" y="124" width="104" height="6" rx="3"></rect>
              <rect class="pa-ink pa-ink--soft" x="210" y="138" width="80" height="5" rx="2.5"></rect>
              <path class="pa-folder-front" d="M70 196h300v144H70z"></path>
              <rect class="pa-label" x="100" y="226" width="120" height="30" rx="4"></rect>
              <rect class="pa-white" x="114" y="238" width="78" height="6" rx="3"></rect>
            </g>

            <!-- 5. Ongoing work -->
            <g class="pa-scene" data-scene="4">
              <path class="pa-card" d={leaf(70, 70, 300, 260, 30, 4)}></path>
              <rect class="pa-ink" x="96" y="96" width="120" height="8" rx="4"></rect>
              {
                Array.from({ length: 28 }).map((_, k) => {
                  const c = k % 7;
                  const r = Math.floor(k / 7);
                  const done = [2, 6, 9, 13, 16, 20, 23].includes(k);
                  return (
                    <g>
                      <rect class={done ? 'pa-cell pa-cell--done' : 'pa-cell'} x={96 + c * 36} y={128 + r * 46} width="28" height="34" rx="4" />
                      {done && <path class="pa-tick pa-tick--white" d={`M${103 + c * 36} ${145 + r * 46}l4 4 7-7.6`} />}
                    </g>
                  );
                })
              }
              <path class="pa-cycle" d="M396 200a26 26 0 1 1-8-18.6"></path>
              <path class="pa-cycle" d="M392 168v14h-14"></path>
            </g>
          </svg>
        </div>
      </div>

      <div class="steps" data-steps>
        <span class="steps__track" aria-hidden="true"><span class="steps__fill" data-steps-fill></span></span>
        <ol class="steps__list" role="list">
        {
          process.steps.map((s, i) => (
            <li class={`step${i === 0 ? ' is-active' : ''}`} data-step={i}>
              <span class="step__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="step__body">
                <h3 class="step__title">
                  <span class="sr-only">Քայլ {i + 1}․ </span>
                  {s.title}
                </h3>
                <p class="step__text">{s.text}</p>
              </div>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .process {
    overflow: clip;
  }

  .process__glow {
    position: absolute;
    inset: -10% -20% auto auto;
    width: 70vw;
    max-width: 900px;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(15, 158, 76, 0.22), transparent 62%);
    pointer-events: none;
  }

  .process__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 104px);
    align-items: start;
  }

  .process__stage {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }

  .process__stage-inner {
    position: relative;
    padding: clamp(18px, 2.4vw, 32px);
    background: var(--night-2);
    border: 1px solid var(--night-line);
    border-radius: var(--radius-leaf-lg);
  }

  .process__counter {
    position: absolute;
    top: clamp(18px, 2.4vw, 30px);
    left: clamp(22px, 2.8vw, 36px);
    font-family: var(--f-display);
    font-size: 1.05rem;
    color: var(--night-muted);
    font-variant-numeric: tabular-nums;
    z-index: 1;
  }

  .process__counter [data-process-current] {
    color: #fff;
    font-size: 1.6rem;
  }

  .process__counter-sep {
    margin-inline: 4px;
  }

  .process__art {
    width: 100%;
    height: auto;
  }

  .pa-scene {
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    transform-origin: 220px 200px;
    transition:
      opacity 0.55s ease,
      transform 0.7s var(--ease-out);
  }

  .pa-scene.is-active {
    opacity: 1;
    transform: none;
  }

  .pa-card {
    fill: #f6f8f5;
  }

  .pa-soft {
    fill: rgba(19, 29, 43, 0.06);
  }

  .pa-green,
  .pa-bubble--green,
  .pa-cell--done,
  .pa-label {
    fill: var(--green);
  }

  .pa-bubble {
    fill: rgba(233, 241, 236, 0.9);
  }

  .pa-bubble--green {
    fill: var(--green);
  }

  .pa-ink {
    fill: #364253;
  }

  .pa-ink--soft {
    fill: rgba(54, 66, 83, 0.32);
  }

  .pa-white {
    fill: #fff;
  }

  .pa-white--soft {
    fill: rgba(255, 255, 255, 0.65);
  }

  .pa-dot {
    fill: #364253;
  }

  .pa-highlight {
    fill: rgba(128, 204, 160, 0.35);
  }

  .pa-lens {
    fill: rgba(128, 204, 160, 0.12);
    stroke: var(--mint);
    stroke-width: 6;
  }

  .pa-lens-handle {
    stroke: var(--mint);
    stroke-width: 12;
    stroke-linecap: round;
  }

  .pa-box {
    fill: var(--mint-soft);
    stroke: var(--green);
    stroke-width: 1.2;
  }

  .pa-tick {
    fill: none;
    stroke: var(--green);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pa-tick--white {
    stroke: #fff;
  }

  .pa-sign {
    fill: none;
    stroke: #131d2b;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .pa-rule {
    stroke: rgba(19, 29, 43, 0.3);
    stroke-width: 1;
  }

  .pa-stamp-ring {
    fill: none;
    stroke: var(--green);
    stroke-width: 2;
    stroke-dasharray: 3 4;
  }

  .pa-stamp-leaf {
    fill: var(--green);
  }

  .pa-stamp-leaf--dark {
    fill: #131d2b;
  }

  .pa-folder-back {
    fill: #0a5130;
  }

  .pa-folder-front {
    fill: var(--green);
  }

  .pa-sheet {
    stroke: rgba(19, 29, 43, 0.12);
  }

  .pa-cell {
    fill: rgba(19, 29, 43, 0.07);
  }

  .pa-cycle {
    fill: none;
    stroke: var(--mint);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Steps */
  .steps {
    position: relative;
  }

  .steps__list {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
  }

  .steps__track {
    position: absolute;
    left: 27px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    background: var(--night-line);
    border-radius: 2px;
    overflow: hidden;
  }

  .steps__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--mint), var(--green));
    transform-origin: top;
    transform: scaleY(1);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    padding-block: clamp(26px, 4vw, 56px);
    min-height: clamp(140px, 22vh, 240px);
  }

  .step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-leaf-sm);
    background: var(--night-2);
    border: 1.5px solid var(--night-line);
    font-family: var(--f-display);
    font-size: 1.15rem;
    color: var(--night-muted);
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.45s ease,
      color 0.45s ease,
      border-color 0.45s ease,
      border-radius 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .step__body {
    display: grid;
    gap: 10px;
    padding-top: 10px;
  }

  .step__title {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    color: #fff;
    transition: color 0.45s ease;
  }

  .step__text {
    color: var(--night-muted);
    max-width: 48ch;
    transition: color 0.45s ease;
  }

  .step.is-active .step__num {
    background: var(--green-ink);
    border-color: var(--green-ink);
    color: #fff;
    border-radius: 14px 3px 14px 3px;
    transform: scale(1.06);
  }

  /* Dim the steps that are not in focus only when the scroll sequence runs */
  .steps--live .step:not(.is-active) .step__title {
    color: #b9c5cf;
  }

  .steps--live .step:not(.is-active) .step__text {
    color: #93a2af;
  }

  .steps--live .steps__fill {
    transform: scaleY(0);
  }

  @media (max-width: 900px) {
    .process__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .process__stage {
      display: none;
    }

    .step {
      min-height: 0;
    }


  }

  @media (prefers-reduced-motion: reduce) {
    .pa-scene {
      transition: none;
    }
  }
</style>
