---
/**
 * Hero illustration: the reporting year as a dial, loose documents settling
 * into an ordered stack, a review checkpoint and a report taking shape.
 * Pure SVG + CSS keyframes, so it plays without JavaScript; the final
 * (resting) state is the base style, which is what reduced-motion users see.
 * It is an abstract illustration — no real figures or client data.
 */
import Icon from './Icon.astro';

const CX = 300;
const CY = 310;
const R = 232;
const months = ['ՀՆՎ', 'ՓՏՎ', 'ՄՐՏ', 'ԱՊՐ', 'ՄՅՍ', 'ՀՆՍ', 'ՀԼՍ', 'ՕԳՍ', 'ՍՊՏ', 'ՀԿՏ', 'ՆՅՄ', 'ԴԿՏ'];

const polar = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)].map((n) => +n.toFixed(2));
};

let minor = '';
for (let i = 0; i < 60; i++) {
  if (i % 5 === 0) continue;
  const deg = -90 + i * 6;
  const [x1, y1] = polar(R - 9, deg);
  const [x2, y2] = polar(R - 3, deg);
  minor += `M${x1} ${y1}L${x2} ${y2}`;
}
const major = months.map((_, i) => {
  const deg = -90 + i * 30;
  const [x1, y1] = polar(R - 15, deg);
  const [x2, y2] = polar(R + 1, deg);
  return `M${x1} ${y1}L${x2} ${y2}`;
});
const labels = months.map((m, i) => {
  const [x, y] = polar(R + 22, -90 + i * 30 + 15);
  return { m, x, y, i };
});

// Default position of the "today" marker = build date; script refreshes it on load.
const now = new Date();
const daysIn = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
const p = +((now.getMonth() + (now.getDate() - 1) / daysIn) / 12).toFixed(4);

/** Rectangle with the logo's leaf corners: square TL/BR, rounded TR/BL. */
const leaf = (x: number, y: number, w: number, h: number, r = 22, s = 4) =>
  `M${x + s} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}V${y + h - s}Q${x + w} ${y + h} ${x + w - s} ${y + h}H${x + r}Q${x} ${y + h} ${x} ${y + h - r}V${y + s}Q${x} ${y} ${x + s} ${y}Z`;

const doc = { w: 176, h: 222 };
const docs = [
  { x: 192, y: 176, rot: -8, fx: -230, fy: -150, fr: -26, d: 0.25 },
  { x: 204, y: 186, rot: -3, fx: 250, fy: -190, fr: 20, d: 0.37 },
  { x: 214, y: 196, rot: 0, fx: -120, fy: 260, fr: -14, d: 0.49 },
];
---

<div class="hero-visual is-playing" style={`--p:${p}`} data-hero-visual>
  <svg
    class="hero-visual__svg"
    viewBox="0 0 600 620"
    role="img"
    aria-label="Նկարազարդում․ տարվա հաշվետու ամիսների շրջանի ֆոնին փաստաթղթերը դասավորվում են կարգով, ստուգվում և վերածվում հաշվետվության"
  >
    <defs>
      <linearGradient id="hv-arc" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#80CCA0"></stop>
        <stop offset="1" stop-color="#0F9E4C"></stop>
      </linearGradient>
      <linearGradient id="hv-glow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#D5ECDD" stop-opacity=".9"></stop>
        <stop offset="1" stop-color="#D5ECDD" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <!-- Back layer: the reporting year -->
    <g class="hv-depth" data-depth="0.25">
    <g class="hv-layer hv-layer--back" data-hv-layer="back">
      <circle class="hv-disc" cx={CX} cy={CY} r={R - 40} fill="url(#hv-glow)"></circle>
      <circle class="hv-ring" cx={CX} cy={CY} r={R} pathLength="1"></circle>
      <circle class="hv-ring hv-ring--inner" cx={CX} cy={CY} r={R - 52}></circle>
      <path class="hv-ticks hv-ticks--minor" d={minor}></path>
      <path class="hv-ticks hv-ticks--major" d={major.join('')}></path>
      <g class="hv-months">
        {
          labels.map((l) => (
            <text class="hv-month" x={l.x} y={l.y}>
              {l.m}
            </text>
          ))
        }
      </g>
      <circle
        class="hv-progress"
        cx={CX}
        cy={CY}
        r={R}
        pathLength="1"
        transform={`rotate(-90 ${CX} ${CY})`}
        data-hv-progress></circle>
      <g class="hv-marker" style={`transform-origin:${CX}px ${CY}px`} data-hv-marker>
        <circle cx={CX} cy={CY - R} r="11" class="hv-marker__halo"></circle>
        <circle cx={CX} cy={CY - R} r="5.5" class="hv-marker__dot"></circle>
      </g>
    </g>
    </g>

    <!-- Middle layer: documents falling into order -->
    <g class="hv-depth" data-depth="0.55">
    <g class="hv-layer hv-layer--mid" data-hv-layer="mid">
      <path
        class="hv-connector"
        d="M390 252 C 432 252, 440 176, 466 176"
        pathLength="1"
        style="--delay:1.35s"></path>
      <path
        class="hv-connector"
        d="M502 210 C 502 288, 470 318, 470 372"
        pathLength="1"
        style="--delay:1.7s"></path>
      {
        docs.map((d, i) => (
          <g
            class="hv-doc"
            style={`--fx:${d.fx}px;--fy:${d.fy}px;--fr:${d.fr}deg;--delay:${d.d}s;transform-origin:${d.x + doc.w / 2}px ${d.y + doc.h / 2}px`}
          >
            <g transform={`rotate(${d.rot} ${d.x + doc.w / 2} ${d.y + doc.h / 2})`}>
              <path class="hv-card-shadow" d={leaf(d.x + 5, d.y + 6, doc.w, doc.h)} />
              <path class="hv-card" d={leaf(d.x, d.y, doc.w, doc.h)} />
              {i === 2 ? (
                <g class="hv-doc__content">
                  <path class="hv-mini-leaf" d={leaf(d.x + 18, d.y + 18, 12, 12, 6, 1.5)} />
                  <path class="hv-mini-leaf hv-mini-leaf--dark" d={leaf(d.x + 24, d.y + 30, 12, 12, 6, 1.5)} />
                  <rect class="hv-line hv-line--strong" x={d.x + 46} y={d.y + 21} width="82" height="7" rx="3.5" />
                  <rect class="hv-line" x={d.x + 46} y={d.y + 34} width="54" height="5" rx="2.5" />
                  <path class="hv-rule" d={`M${d.x + 18} ${d.y + 58}H${d.x + doc.w - 18}`} />
                  <rect class="hv-line" x={d.x + 18} y={d.y + 72} width="140" height="5" rx="2.5" />
                  <rect class="hv-line" x={d.x + 18} y={d.y + 84} width="124" height="5" rx="2.5" />
                  <rect class="hv-line" x={d.x + 18} y={d.y + 96} width="92" height="5" rx="2.5" />
                  {[0, 1, 2].map((r) => (
                    <g>
                      <path class="hv-rule hv-rule--soft" d={`M${d.x + 18} ${d.y + 122 + r * 22}H${d.x + doc.w - 18}`} />
                      <rect class="hv-line" x={d.x + 18} y={d.y + 130 + r * 22} width={[64, 78, 56][r]} height="5" rx="2.5" />
                      <rect class="hv-line hv-line--strong" x={d.x + doc.w - 18 - 34} y={d.y + 130 + r * 22} width="34" height="5" rx="2.5" />
                    </g>
                  ))}
                  <path class="hv-rule hv-rule--double" d={`M${d.x + doc.w - 70} ${d.y + 196}H${d.x + doc.w - 18}M${d.x + doc.w - 70} ${d.y + 200}H${d.x + doc.w - 18}`} />
                  <rect class="hv-line hv-line--green" x={d.x + 18} y={d.y + 194} width="58" height="7" rx="3.5" />
                </g>
              ) : (
                <g class="hv-doc__content hv-doc__content--back">
                  <rect class="hv-line" x={d.x + 18} y={d.y + 22} width="96" height="6" rx="3" />
                  <rect class="hv-line" x={d.x + 18} y={d.y + 38} width="126" height="5" rx="2.5" />
                </g>
              )}
            </g>
          </g>
        ))
      }
    </g>
    </g>

    <!-- Front layer: checkpoints -->
    <g class="hv-depth" data-depth="0.9">
    <g class="hv-layer hv-layer--front" data-hv-layer="front">
      <!-- Deadline calendar -->
      <g class="hv-chip hv-chip--calendar" style="--delay:.85s;transform-origin:122px 134px">
        <path class="hv-card-shadow" d={leaf(46, 78, 160, 124, 18, 3)}></path>
        <path class="hv-card" d={leaf(40, 72, 160, 124, 18, 3)}></path>
        <text class="hv-label" x="58" y="98">Ժամկետներ</text>
        <g class="hv-cells">
          {
            Array.from({ length: 21 }).map((_, k) => {
              const c = k % 7;
              const r = Math.floor(k / 7);
              const cls = k === 11 ? 'hv-cell hv-cell--due' : [3, 9, 17].includes(k) ? 'hv-cell hv-cell--set' : 'hv-cell';
              return <rect class={cls} x={58 + c * 18} y={112 + r * 22} width="12" height="12" rx="2.5" />;
            })
          }
        </g>
        <path class="hv-check hv-check--cell" d="M117 141.5l2.6 2.6 5-5.4" pathLength="1" style="--delay:2.45s"></path>
      </g>

      <!-- Review node -->
      <g class="hv-chip hv-chip--review" style="--delay:1.55s;transform-origin:502px 176px">
        <circle class="hv-review__halo" cx="502" cy="176" r="46"></circle>
        <circle class="hv-card" cx="502" cy="176" r="32"></circle>
        <path class="hv-check" d="M488 177l9 9 18-19" pathLength="1" style="--delay:1.95s"></path>
      </g>

      <!-- Report -->
      <g class="hv-chip hv-chip--report" style="--delay:1.9s;transform-origin:470px 448px">
        <path class="hv-card-shadow" d={leaf(378, 380, 200, 150, 22, 4)}></path>
        <path class="hv-card" d={leaf(372, 374, 200, 150, 22, 4)}></path>
        <text class="hv-label" x="392" y="402">Հաշվետվություն</text>
        <circle class="hv-badge" cx="548" cy="398" r="11"></circle>
        <path class="hv-check hv-check--badge" d="M543 398.5l3.4 3.4 6-6.4" pathLength="1" style="--delay:2.75s"></path>
        <rect class="hv-bar" x="392" y="420" width="150" height="9" rx="2" style="--delay:2.1s"></rect>
        <rect class="hv-bar hv-bar--mint" x="392" y="440" width="112" height="9" rx="2" style="--delay:2.2s"></rect>
        <rect class="hv-bar hv-bar--ink" x="392" y="460" width="132" height="9" rx="2" style="--delay:2.3s"></rect>
        <rect class="hv-bar hv-bar--deep" x="392" y="480" width="84" height="9" rx="2" style="--delay:2.4s"></rect>
        <path class="hv-rule hv-rule--double" d="M392 502H552M392 506H552"></path>
      </g>

      <!-- Checklist -->
      <g class="hv-chip hv-chip--list" style="--delay:1.1s;transform-origin:138px 494px">
        <path class="hv-card-shadow" d={leaf(38, 438, 206, 118, 20, 3)}></path>
        <path class="hv-card" d={leaf(32, 432, 206, 118, 20, 3)}></path>
        {
          ['Փաստաթղթեր', 'Հաշվառում', 'Ժամկետներ'].map((t, i) => (
            <g>
              <path class="hv-box" d={leaf(52, 452 + i * 32, 18, 18, 7, 2)} />
              <path
                class="hv-check hv-check--box"
                d={`M56 ${462 + i * 32}l3.4 3.4 6.2-6.6`}
                pathLength="1"
                style={`--delay:${(2.0 + i * 0.28).toFixed(2)}s`}
              />
              <text class="hv-item" x="82" y={466 + i * 32}>
                {t}
              </text>
            </g>
          ))
        }
      </g>
    </g>
    </g>
  </svg>

  <button class="hero-visual__replay" type="button" data-hv-replay aria-label="Կրկին ցույց տալ նկարազարդման անիմացիան">
    <Icon name="replay" />
  </button>
</div>

<style is:global>
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
    aspect-ratio: 600 / 620;
  }

  .hero-visual__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hv-depth,
  .hv-layer {
    will-change: transform;
  }

  .hv-disc {
    opacity: 0.8;
  }

  .hv-ring {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .hv-ring--inner {
    stroke: var(--line);
    stroke-dasharray: 2 7;
  }

  .hv-ticks {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .hv-ticks--major {
    stroke: var(--ink-2);
    stroke-width: 1.4;
    opacity: 0.55;
  }

  .hv-month {
    font-family: var(--f-body);
    font-size: 12.5px;
    font-weight: 600;
    font-stretch: 75%;
    letter-spacing: 0.08em;
    fill: var(--muted);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .hv-progress {
    fill: none;
    stroke: url(#hv-arc);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: var(--p) 1;
  }

  .hv-marker {
    transform: rotate(calc(var(--p) * 360deg));
  }

  .hv-marker__halo {
    fill: var(--mint);
    opacity: 0.45;
  }

  .hv-marker__dot {
    fill: var(--green);
    stroke: var(--card);
    stroke-width: 2.5;
  }

  .hv-card {
    fill: var(--card);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .hv-card-shadow {
    fill: var(--ink);
    opacity: 0.07;
  }

  .hv-line {
    fill: var(--line-strong);
  }

  .hv-line--strong {
    fill: var(--ink-2);
    opacity: 0.55;
  }

  .hv-line--green {
    fill: var(--green);
  }

  .hv-rule {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .hv-rule--soft {
    stroke: var(--line);
  }

  .hv-rule--double {
    stroke: var(--ink);
    stroke-width: 1.2;
    opacity: 0.7;
  }

  .hv-mini-leaf {
    fill: var(--green);
  }

  .hv-mini-leaf--dark {
    fill: var(--ink);
  }

  .hv-connector {
    fill: none;
    stroke: var(--green);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .hv-label {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 650;
    fill: var(--ink);
  }

  .hv-label--center {
    text-anchor: middle;
    font-size: 12.5px;
    fill: var(--ink-2);
  }

  .hv-item {
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 500;
    fill: var(--ink-2);
  }

  .hv-cell {
    fill: var(--paper-2);
  }

  .hv-cell--set {
    fill: var(--mint-soft);
  }

  .hv-cell--due {
    fill: var(--green);
  }

  .hv-check {
    fill: none;
    stroke: var(--green);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }

  .hv-check--cell,
  .hv-check--badge {
    stroke: #fff;
    stroke-width: 2;
  }

  .hv-check--box {
    stroke-width: 2.2;
  }

  .hv-box {
    fill: var(--mint-soft);
    stroke: var(--green);
    stroke-width: 1.2;
  }

  .hv-badge {
    fill: var(--green);
  }

  .hv-review__halo {
    fill: var(--mint-soft);
    opacity: 0.6;
  }

  .hv-bar {
    fill: var(--green);
    transform-box: fill-box;
    transform-origin: left center;
  }

  .hv-bar--mint {
    fill: var(--mint);
  }

  .hv-bar--ink {
    fill: var(--ink-2);
    opacity: 0.35;
  }

  .hv-bar--deep {
    fill: var(--green-deep);
  }

  .hero-visual__replay {
    position: absolute;
    right: 4%;
    bottom: 1%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--card);
    color: var(--ink-2);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.4s ease,
      transform 0.4s var(--ease-out);
  }

  .hero-visual:hover .hero-visual__replay,
  .hero-visual__replay:focus-visible {
    opacity: 1;
  }

  .hero-visual__replay:hover .icon {
    transform: rotate(-120deg);
  }

  .hero-visual__replay .icon {
    width: 18px;
    height: 18px;
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: none) {
    .hero-visual__replay {
      opacity: 0.85;
    }
  }

  /* ---------- Intro sequence (≈3.2 s, then still) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-visual.is-playing .hv-ring {
      stroke-dasharray: 1;
      animation: hv-draw 1.4s var(--ease-in-out) 0.05s both;
    }

    .hero-visual.is-playing .hv-disc {
      animation: hv-fade 1.6s ease 0.1s both;
    }

    .hero-visual.is-playing .hv-ring--inner,
    .hero-visual.is-playing .hv-ticks--minor {
      animation: hv-fade 1s ease 0.5s both;
    }

    .hero-visual.is-playing .hv-ticks--major,
    .hero-visual.is-playing .hv-months {
      animation: hv-fade 0.9s ease 0.35s both;
    }

    .hero-visual.is-playing .hv-progress {
      animation: hv-arc 1.5s var(--ease-in-out) 1.8s both;
    }

    .hero-visual.is-playing .hv-marker {
      animation: hv-marker 1.5s var(--ease-in-out) 1.8s both;
    }

    .hero-visual.is-playing .hv-doc {
      animation: hv-doc-in 1.25s var(--ease-out) both;
      animation-delay: var(--delay);
    }

    .hero-visual.is-playing .hv-connector {
      animation: hv-draw 0.7s var(--ease-in-out) both;
      animation-delay: var(--delay);
    }

    .hero-visual.is-playing .hv-chip {
      animation: hv-pop 0.8s var(--ease-out) both;
      animation-delay: var(--delay);
    }

    .hero-visual.is-playing .hv-check {
      animation: hv-draw 0.45s var(--ease-out) both;
      animation-delay: var(--delay);
    }

    .hero-visual.is-playing .hv-cells {
      animation: hv-fade 0.6s ease 1.05s both;
    }

    .hero-visual.is-playing .hv-cell--due {
      animation: hv-fade 0.4s ease 2.3s both;
    }

    .hero-visual.is-playing .hv-bar {
      animation: hv-bar 0.7s var(--ease-out) both;
      animation-delay: var(--delay);
    }
  }

  @keyframes hv-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hv-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hv-arc {
    from {
      stroke-dasharray: 0 1;
    }
  }

  @keyframes hv-marker {
    from {
      transform: rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
  }

  @keyframes hv-doc-in {
    from {
      opacity: 0;
      transform: translate(var(--fx), var(--fy)) rotate(var(--fr)) scale(0.92);
    }
    55% {
      opacity: 1;
    }
  }

  @keyframes hv-pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.94);
    }
  }

  @keyframes hv-bar {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual__replay {
      display: none;
    }
  }
</style>
