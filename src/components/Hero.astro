---
import HeroVisual from './HeroVisual.astro';
import Icon from './Icon.astro';
import { business, hero } from '../data/site';
const words = hero.titleLead.split(' ');
const phone = business.phones[0];
---

<section class="hero" id="top" data-hero>
  <div class="ledger-bg hero__ledger" data-hero-bg aria-hidden="true"></div>
  <div class="wrap hero__grid">
    <div class="hero__copy" data-hero-copy>
      <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title">
        {
          words.map((w, i) => (
            <>
              <span class="hero__word" style={`--i:${i}`}>
                <span>{w}</span>
              </span>{' '}
            </>
          ))
        }
        <span class="hero__word hero__word--accent" style={`--i:${words.length}`}>
          <span class="accent-gradient">{hero.titleAccent}</span>
          <span class="hero__underline" aria-hidden="true"><span></span><span></span></span>
        </span>
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#contact" data-magnetic>
          <span>{hero.primaryCta}</span>
          <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost" href="#services" data-magnetic>
          <span>{hero.secondaryCta}</span>
        </a>
      </div>
      <dl class="hero__facts">
        <div>
          <dt><Icon name="clock" /><span>Աշխատանքային ժամեր</span></dt>
          <dd>{business.hours.short}</dd>
        </div>
        <div>
          <dt><Icon name="pin" /><span>Գրասենյակ</span></dt>
          <dd>
            <a href={business.maps.google} target="_blank" rel="noopener">{business.address.streetShort}</a>
          </dd>
        </div>
        <div>
          <dt><Icon name="phone" /><span>Հեռախոս</span></dt>
          <dd><a href={`tel:${phone.tel}`}>{phone.display}</a></dd>
        </div>
      </dl>
    </div>
    <div class="hero__visual" data-hero-visual-wrap>
      <HeroVisual />
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    padding-block: clamp(28px, 4vw, 64px) clamp(64px, 8vw, 120px);
    overflow: clip;
  }

  .hero__ledger {
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 78% 42%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 60% 70% at 78% 42%, #000 15%, transparent 72%);
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }

  .hero__copy {
    display: grid;
    gap: 26px;
    min-width: 0;
  }

  .hero__title {
    font-size: var(--t-hero);
    font-weight: 420;
    line-height: 1.04;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  .hero__word {
    display: inline-block;
    position: relative;
  }

  .hero__word > span:not(.hero__underline) {
    display: inline-block;
  }

  .hero__word--accent {
    padding-bottom: 0.16em;
  }

  .hero__underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.07em;
  }

  .hero__underline span {
    display: block;
    height: max(2px, 0.035em);
    background: var(--ink);
    transform-origin: left;
  }

  .hero__lead {
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0;
    margin-top: 6px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }

  .hero__facts > div {
    padding-right: clamp(16px, 2.2vw, 32px);
    margin-right: clamp(16px, 2.2vw, 32px);
    border-right: 1px solid var(--line);
    min-width: 0;
  }

  .hero__facts > div:last-child {
    border-right: 0;
    margin-right: 0;
    padding-right: 0;
  }

  .hero__facts dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-label);
    font-weight: 650;
    font-stretch: 75%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__facts dt .icon {
    width: 15px;
    height: 15px;
    color: var(--green-ink);
  }

  .hero__facts dd {
    margin-top: 4px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .hero__facts a {
    text-decoration: none;
  }

  .hero__facts a:hover {
    color: var(--green-ink);
  }

  .hero__visual {
    min-width: 0;
    margin-right: calc(-1 * clamp(0px, 3vw, 48px));
  }

  /* Intro: words rise quickly (≈0.9 s total) — readable from the first frame */
  @media (prefers-reduced-motion: no-preference) {
    .hero__word > span:not(.hero__underline) {
      animation: hero-word 0.9s var(--ease-out) both;
      animation-delay: calc(var(--i) * 55ms);
    }

    .hero__underline span {
      animation: hero-rule 0.7s var(--ease-in-out) both;
      animation-delay: 0.75s;
    }

    .hero__underline span + span {
      animation-delay: 0.9s;
    }

    .hero__eyebrow,
    .hero__lead,
    .hero__ctas,
    .hero__facts {
      animation: hero-fade 0.8s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 0.2s;
    }

    .hero__ctas {
      animation-delay: 0.3s;
    }

    .hero__facts {
      animation-delay: 0.4s;
    }
  }

  @keyframes hero-word {
    from {
      opacity: 0.001;
      transform: translateY(0.45em);
    }
  }

  @keyframes hero-rule {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0.001;
      transform: translateY(10px);
    }
  }

  @media (max-width: 1040px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__visual {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .hero__facts {
      grid-template-columns: 1fr 1fr;
      row-gap: 14px;
    }

    .hero__facts > div:nth-child(2) {
      border-right: 0;
      margin-right: 0;
      padding-right: 0;
    }

    .hero__facts > div:last-child {
      grid-column: 1 / -1;
    }

    .hero__ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
