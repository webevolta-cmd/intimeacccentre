---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Importance from '../components/Importance.astro';
import Services from '../components/Services.astro';
import Finder from '../components/Finder.astro';
import Process from '../components/Process.astro';
import Trust from '../components/Trust.astro';
import About from '../components/About.astro';
import Insights from '../components/Insights.astro';
import Courses from '../components/Courses.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---

<Base structuredData>
  <Header />
  <main id="main">
    <Hero />
    <Importance />
    <Services />
    <Finder />
    <Process />
    <Trust />
    <About />
    <Insights />
    <Courses />
    <Faq />
    <Contact />
    <FinalCta />
  </main>
  <Footer />
  <MobileBar />
</Base>
